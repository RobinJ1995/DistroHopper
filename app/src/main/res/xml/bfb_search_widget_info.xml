<?xml version="1.0" encoding="utf-8"?>
<!--
	The BFB search widget: identical to the BFB widget, but tapping it opens the
	dash with the search field focused (keyboard up). Resizable; the bitmap is
	re-rendered for the new size. updatePeriodMillis is 0 — the content only
	changes on theme/wallpaper changes, which the app pushes via requestUpdate.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
	android:minWidth="60dp"
	android:minHeight="60dp"
	android:targetCellWidth="1"
	android:targetCellHeight="1"
	android:resizeMode="horizontal|vertical"
	android:widgetCategory="home_screen"
	android:updatePeriodMillis="0"
	android:description="@string/bfb_search_widget_description"
	android:previewLayout="@layout/widget_bfb"
	android:previewImage="@drawable/launcher_bfb"
	android:initialLayout="@layout/widget_bfb" />
