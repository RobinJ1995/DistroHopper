<?xml version="1.0" encoding="utf-8"?>

<!-- One workspace (personal/work profile) section in the dash: a label and
     the workspace's app grid, expanded to full height so the sections scroll
     together inside svDashHomeWorkspaces. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <TextView
        android:id="@+id/tvWorkspaceLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:textColor="@android:color/white"
        android:textAppearance="@style/textshadow_2px_black" />

    <be.robinj.distrohopper.desktop.dash.ExpandedGridView
        android:id="@+id/gvWorkspaceApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:choiceMode="singleChoice"
        android:columnWidth="@dimen/dash_applauncher_width"
        android:focusableInTouchMode="false"
        android:gravity="center"
        android:numColumns="auto_fit"
        android:scrollbars="none" />

</LinearLayout>
