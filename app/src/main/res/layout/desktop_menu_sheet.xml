<?xml version="1.0" encoding="utf-8"?>
<!-- The long-press-on-empty-desktop bottom sheet (see home/DesktopMenuOverlay):
     the desktop-level actions laid out side by side, each an icon above its
     label. The rounded frosted surface behind them is the *window* background
     (DesktopMenuSheetTheme), not a background here — that is what clips the
     window's blur-behind to the sheet's shape. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/desktopMenuSheet"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingLeft="12dp"
	android:paddingTop="8dp"
	android:paddingRight="12dp"
	android:paddingBottom="16dp">

	<View
		android:layout_width="36dp"
		android:layout_height="4dp"
		android:layout_gravity="center_horizontal"
		android:layout_marginBottom="12dp"
		android:background="@drawable/desktop_menu_handle" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:baselineAligned="false"
		android:orientation="horizontal">

		<LinearLayout
			android:id="@+id/rowDesktopMenuAddWidget"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="@drawable/dialog_list_item_background"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:paddingLeft="4dp"
			android:paddingTop="12dp"
			android:paddingRight="4dp"
			android:paddingBottom="12dp">

			<FrameLayout
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="@drawable/desktop_menu_icon_background">

				<ImageView
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_gravity="center"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_desktop_menu_widgets"
					android:tint="@color/dialog_on_surface" />
			</FrameLayout>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="sans-serif-medium"
				android:gravity="center_horizontal"
				android:text="@string/desktop_menu_widgets"
				android:textColor="@color/dialog_on_surface"
				android:textSize="14sp" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/rowDesktopMenuCustomise"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="@drawable/dialog_list_item_background"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:paddingLeft="4dp"
			android:paddingTop="12dp"
			android:paddingRight="4dp"
			android:paddingBottom="12dp">

			<FrameLayout
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="@drawable/desktop_menu_icon_background">

				<ImageView
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_gravity="center"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_desktop_menu_customise"
					android:tint="@color/dialog_on_surface" />
			</FrameLayout>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="sans-serif-medium"
				android:gravity="center_horizontal"
				android:text="@string/option_customise"
				android:textColor="@color/dialog_on_surface"
				android:textSize="14sp" />
		</LinearLayout>

		<LinearLayout
			android:id="@+id/rowDesktopMenuSettings"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:background="@drawable/dialog_list_item_background"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			android:paddingLeft="4dp"
			android:paddingTop="12dp"
			android:paddingRight="4dp"
			android:paddingBottom="12dp">

			<FrameLayout
				android:layout_width="48dp"
				android:layout_height="48dp"
				android:background="@drawable/desktop_menu_icon_background">

				<ImageView
					android:layout_width="24dp"
					android:layout_height="24dp"
					android:layout_gravity="center"
					android:importantForAccessibility="no"
					android:src="@drawable/ic_desktop_menu_settings"
					android:tint="@color/dialog_on_surface" />
			</FrameLayout>

			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:fontFamily="sans-serif-medium"
				android:gravity="center_horizontal"
				android:text="@string/desktop_menu_settings"
				android:textColor="@color/dialog_on_surface"
				android:textSize="14sp" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
