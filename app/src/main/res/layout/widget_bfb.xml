<?xml version="1.0" encoding="utf-8"?>
<!--
	The BFB widget's RemoteViews. A single ImageView whose bitmap is rendered by
	BfbWidgetProvider in the active theme; the static src is only the placeholder
	shown before the first update (and in the picker preview).
-->
<ImageView xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/imgBfbWidget"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:scaleType="fitCenter"
	android:adjustViewBounds="true"
	android:contentDescription="@string/bfb_widget_label"
	android:src="@drawable/launcher_bfb" />
