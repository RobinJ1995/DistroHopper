<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingLeft="@dimen/activity_horizontal_margin"
                android:paddingRight="@dimen/activity_horizontal_margin"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                tools:context="be.robinj.distrohopper.preferences.LocalFilesFoldersActivity">

    <Button
        android:id="@+id/btnAddFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/onboarding_button_primary"
        android:stateListAnimator="@null"
        android:text="@string/local_files_folders_add"
        android:textColor="@android:color/white" />

    <!-- Spans the whole area above the button so the message sits in the middle
         of the empty space, rather than hugging the button. -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@id/btnAddFolder"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:padding="24dp"
        android:text="@string/local_files_folders_empty"
        android:textColor="@color/transparent30"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/lvFolders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnAddFolder"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</RelativeLayout>
