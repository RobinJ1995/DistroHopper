<?xml version="1.0" encoding="utf-8"?>
<!-- One developer log row: a severity stripe, a dim metadata line and the message.
     Weight is expressed with android:textStyle rather than a fontFamily —
     FontInflaterFactory swaps the family on every TextView to honour the font
     preference, so a fontFamily here would silently vanish on non-System fonts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:paddingStart="14dp"
              android:paddingEnd="14dp"
              android:paddingTop="9dp"
              android:paddingBottom="9dp">

    <View
        android:id="@+id/vLogLevel"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/dev_log_level_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/dialog_on_surface_dim"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvLogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="14sp"
            android:textColor="@color/dialog_on_surface"
            android:lineSpacingMultiplier="1.2"
            android:textIsSelectable="true" />

    </LinearLayout>

</LinearLayout>
