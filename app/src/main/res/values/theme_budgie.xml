<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="theme_budgie_card_colour">#6bcb82</color>
    <drawable name="theme_budgie_card_logo">@drawable/theme_budgie_res_card_logo</drawable>
    <drawable name="theme_budgie_wallpaper_overlay">@android:color/transparent</drawable>
    <drawable name="theme_budgie_wallpaper_overlay_when_dash_opened">@android:color/transparent</drawable>
    <integer name="theme_budgie_dynamic_background_opacity">50</integer>

    <!-- The dock / launcher surface: opaque Arc-Dark, full-bleed against the
         screen edge. Also the status bar when the launcher is at the top. -->
    <drawable name="theme_budgie_dock">#FF20222A</drawable>

    <!-- Launcher -->
    <integer name="theme_budgie_launcher_location">@integer/position_bottom</integer>
    <array name="theme_budgie_launcher_location_supported">
        <item>@integer/position_top</item>
        <item>@integer/position_right</item>
        <item>@integer/position_bottom</item>
        <item>@integer/position_left</item>
    </array>
    <array name="theme_budgie_launcher_margin">
        <item>0dp</item>
        <item>0dp</item>
        <item>0dp</item>
        <item>0dp</item>
    </array>
    <bool name="theme_budgie_launcher_expand">true</bool>
    <bool name="theme_budgie_launcher_background_dynamic">false</bool>
    <array name="theme_budgie_launcher_background">
        <item>@android:color/transparent</item>
        <item>@drawable/theme_budgie_dock</item>
        <item>@drawable/theme_budgie_dock</item>
        <item>@drawable/theme_budgie_dock</item>
        <item>@drawable/theme_budgie_dock</item>
    </array>
    <integer name="theme_budgie_launcher_bfb_location">@integer/position_left</integer>
    <drawable name="theme_budgie_launcher_bfb_image">@drawable/theme_budgie_res_launcher_bfb</drawable>
    <drawable name="theme_budgie_launcher_bfb_image_vertical">@drawable/theme_budgie_res_launcher_bfb</drawable>
    <bool name="theme_budgie_launcher_bfb_hide_while_dragging">false</bool>
    <integer name="theme_budgie_launcher_preferences_location">@integer/position_right</integer>
    <drawable name="theme_budgie_launcher_preferences_image">@drawable/theme_budgie_res_launcher_preferences</drawable>
    <integer name="theme_budgie_launcher_preferences_location_when_panel_hidden">@integer/position_right</integer>
    <drawable name="theme_budgie_launcher_trash_image">@drawable/launcher_trash</drawable>
    <bool name="theme_budgie_launcher_applauncher_backgroundcolour_dynamic">false</bool>
    <color name="theme_budgie_launcher_applauncher_backgroundcolour">@android:color/transparent</color>
    <integer name="theme_budgie_launcher_applauncher_backgroundcolour_opacity">204</integer>
    <dimen name="theme_budgie_launcher_applauncher_margin">6dp</dimen>
    <dimen name="theme_budgie_launcher_applauncher_margin_edge">2dp</dimen>
    <drawable name="theme_budgie_launcher_applauncher_background">@drawable/blank_gradient</drawable>
    <drawable name="theme_budgie_launcher_applauncher_gradient">@android:color/transparent</drawable>
    <drawable name="theme_budgie_launcher_applauncher_running">@drawable/theme_budgie_res_launcher_app_running</drawable>
    <bool name="theme_budgie_launcher_applauncher_running_backgroundcolour_dynamic">false</bool>
    <color name="theme_budgie_launcher_applauncher_running_backgroundcolour">#3A3C43</color>

    <!-- Panel: Budgie has none. The status bar follows the launcher edge
         (statusbar_follows_launcher_edge in Budgie.java). -->
    <integer name="theme_budgie_panel_location">@integer/position_none</integer>
    <array name="theme_budgie_panel_location_supported">
    </array>
    <dimen name="theme_budgie_panel_height">28dp</dimen>
    <drawable name="theme_budgie_panel_background">@android:color/transparent</drawable>
    <drawable name="theme_budgie_panel_background_when_dash_opened">@android:color/transparent</drawable>
    <drawable name="theme_budgie_statusbar_background">@drawable/theme_budgie_dock</drawable>
    <drawable name="theme_budgie_statusbar_background_when_panel_not_top">@android:color/transparent</drawable>
    <drawable name="theme_budgie_statusbar_background_when_dash_opened">@drawable/theme_budgie_dock</drawable>
    <bool name="theme_budgie_panel_background_dynamic_when_dash_opened">false</bool>
    <integer name="theme_budgie_panel_bfb_location">@integer/position_none</integer>
    <drawable name="theme_budgie_panel_bfb_image">@android:color/transparent</drawable>
    <string name="theme_budgie_panel_bfb_text">@android:string/no</string>
    <color name="theme_budgie_panel_bfb_text_colour">@android:color/white</color>
    <integer name="theme_budgie_panel_close_location">@integer/position_none</integer>
    <drawable name="theme_budgie_panel_close_image">@android:color/transparent</drawable>
    <integer name="theme_budgie_panel_preferences_location">@integer/position_right</integer>
    <drawable name="theme_budgie_panel_preferences_image">@drawable/panel_cog</drawable>
    <array name="theme_budgie_panel_swap_close_preferences_when_launcher_location">
    </array>

    <!-- Dash: a floating Arc-Dark popover with an ear pointing at the BFB.
         The ear follows the launcher edge via dash_background_edge (indexed by
         Location.n: none, top, right, bottom, left). -->
    <bool name="theme_budgie_dash_background_dynamic">false</bool>
    <drawable name="theme_budgie_dash_background">@drawable/theme_budgie_res_dash_background_bottom</drawable>
    <array name="theme_budgie_dash_background_edge">
        <item>@drawable/theme_budgie_res_dash_background_bottom</item>
        <item>@drawable/theme_budgie_res_dash_background_top</item>
        <item>@drawable/theme_budgie_res_dash_background_right</item>
        <item>@drawable/theme_budgie_res_dash_background_bottom</item>
        <item>@drawable/theme_budgie_res_dash_background_left</item>
    </array>
    <drawable name="theme_budgie_dash_background_gradient">@android:color/transparent</drawable>
    <color name="theme_budgie_dash_applauncher_text_colour">#D3DAE3</color>
    <color name="theme_budgie_dash_applauncher_text_shadow_colour">@android:color/transparent</color>
    <color name="theme_budgie_dash_customise_text_colour">#D3DAE3</color>
    <color name="theme_budgie_dash_customise_text_shadow_colour">@android:color/transparent</color>
    <color name="theme_budgie_dash_customise_spinner_text_colour">@android:color/primary_text_dark</color>
    <dimen name="theme_budgie_dash_search_width">0dp</dimen>
    <drawable name="theme_budgie_dash_search_background">@drawable/theme_budgie_res_dash_search_background</drawable>
    <color name="theme_budgie_dash_search_text_colour">#D3DAE3</color>
    <bool name="theme_budgie_dash_ribbon_show">false</bool>
    <dimen name="theme_budgie_dash_blur_radius">5dp</dimen>
    <integer name="theme_budgie_dash_animation">@integer/dash_animation_budgie</integer>
</resources>
