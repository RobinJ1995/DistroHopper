    <color name="transparent70">#4DFFFFFF</color>
    <color name="transparent60">#66FFFFFF</color>
    <color name="transparent50">#80FFFFFF</color>
    <color name="transparent40">#99FFFFFF</color>
    <color name="transparent30">#B3FFFFFF</color>
    <color name="transparent20">#CCFFFFFF</color>
    <color name="transparent10">#E6FFFFFF</color>

    <color name="transparentblack90">#1A000000</color>
    <color name="transparentblack80">#33000000</color>
    <color name="transparentblack70">#4D000000</color>
    <color name="transparentblack60">#66000000</color>
    <color name="transparentblack50">#80000000</color>
    <color name="transparentblack40">#99000000</color>
    <color name="transparentblack30">#B3000000</color>
