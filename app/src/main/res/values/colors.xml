    <color name="transparentblack10">#E6000000</color>

    <color name="onboarding_accent">#E95420</color>
    <color name="onboarding_accent_pressed">#C7431B</color>

    <!-- Modern dialog palette (widget picker, icon pack picker, lens errors, …).
         A dark, slightly translucent surface: the window blur behind it gives a
         frosted-glass look instead of a blinding solid panel. -->
    <color name="dialog_surface">#CC1C1C1E</color>
    <color name="dialog_on_surface">#FFFFFFFF</color>
    <color name="dialog_on_surface_variant">#B3FFFFFF</color>
    <!-- A dimmer on-surface tone for eyebrows, subtitles and hairline dividers. -->
    <color name="dialog_on_surface_dim">#80FFFFFF</color>
    <color name="dialog_divider">#14FFFFFF</color>
    <!-- The device's system primary colour (Material You, API 31+); the lighter
         200 tone reads well on the dark surface. -->
    <color name="dialog_accent">@android:color/system_accent1_200</color>
    <color name="dialog_preview_background">#1AFFFFFF</color>
    <color name="dialog_ripple">#26FFFFFF</color>

    <!-- Severity accents for the developer log rows. Tuned so warnings and errors
         carry on the dark dialog surface while the routine levels stay quiet: the
         point of the colour is to let the two that matter be found by scanning. -->
    <color name="log_level_verbose">#66FFFFFF</color>
    <color name="log_level_debug">#8C9AA6</color>
    <color name="log_level_info">#7FB8E6</color>
    <color name="log_level_warn">#E8B44A</color>
    <color name="log_level_error">#E86A5E</color>
</resources>