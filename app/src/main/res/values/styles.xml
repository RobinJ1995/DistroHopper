<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <!-- Required for Window#setBackgroundBlurRadius; a transparent background alone doesn't
             make Window#isTranslucent() true, and DecorView ignores the blur radius otherwise. -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Pop-up dialogs spawned from the launcher (e.g. the widget picker)
             pick up the modern look. -->
        <item name="alertDialogTheme">@style/ModernDialogTheme</item>
    </style>

    <style name="HomeTheme" parent="AppTheme">
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- Full-screen over the wallpaper, like the home screen itself. -->
    <style name="OnboardingTheme" parent="AppTheme">
    </style>

    <style name="DialogTheme" parent="Theme.AppCompat">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
        <!-- Blur the wallpaper showing through; the dim above doubles as the
             fallback wherever cross-window blur is unavailable. -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackgroundBlurRadius">@dimen/dialog_blur_radius</item>
        <!-- Pop-up dialogs spawned from these activities (e.g. the icon-pack
             ListPreference) pick up the modern look. -->
        <item name="alertDialogTheme">@style/ModernDialogTheme</item>
    </style>

    <!-- Shared modern styling for the app's pop-up dialogs: a dark, frosted
         (translucent + blurred) surface, the system primary accent, and modern
         typography. -->
    <style name="ModernDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/dialog_accent</item>
        <!-- android:-prefixed so framework dialogs (e.g. the crash reporter) match too. -->
        <item name="android:colorAccent">@color/dialog_accent</item>
        <item name="android:colorBackground">@color/dialog_surface</item>
        <item name="android:windowBackground">@drawable/dialog_window_background</item>
        <item name="android:textColorPrimary">@color/dialog_on_surface</item>
        <item name="android:textColorSecondary">@color/dialog_on_surface_variant</item>
        <!-- Translucent so the blur shows through the surface (frosted glass). -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Carry our own blur + dim so the backdrop stays consistently dark.
             Host activities like Preferences dim the wallpaper via cross-window
             blur, which the system drops once this dialog takes focus; without
             this the raw wallpaper would show through, brightly. -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">@dimen/dialog_blur_radius</item>
        <item name="android:windowTitleStyle">@style/ModernDialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/ModernDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/ModernDialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/ModernDialogButton</item>
    </style>

    <style name="ModernDialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/dialog_on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ModernDialogButton" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textColor">@color/dialog_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- The desktop menu's bottom sheet (home/DesktopMenuOverlay). It is a window of
         its own, not a view in the home screen, purely so the inherited blur-behind
         covers *only* what the sheet covers: cross-window blur is clipped to the
         window's bounds and its background's alpha, which no in-activity view can do
         (a view's RenderEffect blurs its own content, and never the wallpaper, which
         lives in a separate system window). Only the top corners are rounded — the
         bottom edge sits on the screen edge. -->
    <style name="DesktopMenuSheetTheme" parent="ModernDialogTheme">
        <item name="android:windowBackground">@drawable/desktop_menu_sheet_background</item>
        <item name="android:windowAnimationStyle">@style/DesktopMenuSheetAnimation</item>
        <!-- The two blur attributes are NOT interchangeable. windowBlurBehindRadius
             (FLAG_BLUR_BEHIND, what ModernDialogTheme uses) blurs the whole screen
             behind the window; windowBackgroundBlurRadius blurs only within the
             window's own bounds, clipped by the window background's alpha — i.e.
             this sheet's rounded shape. Turn the inherited one off and use the
             within-bounds one, otherwise the entire home screen frosts over. -->
        <item name="android:windowBlurBehindEnabled">false</item>
        <item name="android:windowBackgroundBlurRadius">@dimen/dialog_blur_radius</item>
    </style>

    <style name="DesktopMenuSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/desktop_menu_sheet_in</item>
        <item name="android:windowExitAnimation">@anim/desktop_menu_sheet_out</item>
    </style>

    <style name="AboutTheme" parent="DialogTheme">
    </style>

    <style name="PreferencesTheme" parent="DialogTheme">
        <item name="preferenceTheme">@style/AppPreferenceThemeOverlay</item>
    </style>

    <!-- Don't reserve icon space; the framework preferences this app used before didn't either. -->
    <style name="AppPreferenceThemeOverlay" parent="PreferenceThemeOverlay">
        <item name="preferenceStyle">@style/AppPreference</item>
        <item name="checkBoxPreferenceStyle">@style/AppCheckBoxPreference</item>
        <item name="switchPreferenceCompatStyle">@style/AppSwitchPreference</item>
        <item name="dialogPreferenceStyle">@style/AppDialogPreference</item>
        <item name="preferenceCategoryStyle">@style/AppPreferenceCategory</item>
    </style>

    <style name="AppPreference" parent="Preference.Material">
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="AppCheckBoxPreference" parent="Preference.CheckBoxPreference.Material">
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="AppSwitchPreference" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="AppDialogPreference" parent="Preference.DialogPreference.Material">
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="AppPreferenceCategory" parent="Preference.Category.Material">
        <item name="iconSpaceReserved">false</item>
    </style>

    <style name="ThemePreferencesTheme" parent="DialogTheme">
    </style>

    <style name="LensPreferencesTheme" parent="DialogTheme">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="DevLogsTheme" parent="DialogTheme">
    </style>

    <style name="textshadow_2px_black" parent="android:TextAppearance.Holo.Widget.TextView">
        <item name="android:shadowColor">@android:color/black</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">5</item>
    </style>


    <style name="developer_by" parent="TextAppearance.AppCompat.Large">
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Customise mode (activity_home_customise.xml). Weight is set with
         android:textStyle rather than a fontFamily so the font preference wins;
         see the layout's comment. -->

    <style name="CustomiseGroupLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CustomiseCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/customise_card_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <!-- Spacing between settings as a divider rather than a margin: a
             hidden setting (the menu button on themes without one) then takes
             its gap with it. -->
        <item name="android:divider">@drawable/customise_setting_divider</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="CustomiseSetting">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="CustomiseSettingTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A slider's live value ("Default · 6 icons", "5 × 4"), trailing its
         control. Beside the setting's name it would wrap the name instead:
         the dash is narrow, and these read long in most languages. -->
    <style name="CustomiseSettingValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="CustomiseSettingHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/transparent30</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="CustomiseSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <!-- The track spans the card's padding instead of the widget's own. -->
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:progressTint">@android:color/white</item>
        <item name="android:progressBackgroundTint">@color/transparent60</item>
        <item name="android:thumbTint">@android:color/white</item>
        <item name="android:splitTrack">false</item>
    </style>

    <!-- The row a setting's options sit in, one segment each. -->
    <style name="CustomiseSegments">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:divider">@drawable/customise_segment_divider</item>
        <item name="android:showDividers">middle</item>
    </style>

    <style name="CustomiseSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/customise_segment_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/customise_segment_text</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
