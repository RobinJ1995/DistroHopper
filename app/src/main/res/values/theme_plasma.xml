<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="theme_plasma_card_colour">#1D99F3</color>
    <drawable name="theme_plasma_card_logo">@drawable/theme_plasma_res_card_logo</drawable>
    <drawable name="theme_plasma_wallpaper_overlay">@android:color/transparent</drawable>
    <drawable name="theme_plasma_wallpaper_overlay_when_dash_opened">@android:color/transparent</drawable>
    <integer name="theme_plasma_dynamic_background_opacity">50</integer>

    <!-- Launcher -->
    <integer name="theme_plasma_launcher_location">@integer/position_bottom</integer>
    <array name="theme_plasma_launcher_location_supported">
        <item>@integer/position_bottom</item>
        <item>@integer/position_top</item>
        <item>@integer/position_left</item>
        <item>@integer/position_right</item>
    </array>
    <array name="theme_plasma_launcher_margin">
        <item>5dp</item>
        <item>5dp</item>
        <item>5dp</item>
        <item>5dp</item>
    </array>
    <bool name="theme_plasma_launcher_expand">true</bool>
    <bool name="theme_plasma_launcher_background_dynamic">false</bool>
    <array name="theme_plasma_launcher_background">
        <item>@android:color/transparent</item>
        <item>@drawable/theme_plasma_res_launcher_background_top</item>
        <item>@drawable/theme_plasma_res_launcher_background_right</item>
        <item>@drawable/theme_plasma_res_launcher_background_bottom</item>
        <item>@drawable/theme_plasma_res_launcher_background_left</item>
    </array>
    <integer name="theme_plasma_launcher_bfb_location">@integer/position_left</integer>
    <drawable name="theme_plasma_launcher_bfb_image">@drawable/theme_plasma_res_launcher_bfb</drawable>
    <drawable name="theme_plasma_launcher_bfb_image_vertical">@drawable/theme_plasma_res_launcher_bfb</drawable>
    <bool name="theme_plasma_launcher_bfb_hide_while_dragging">false</bool>
    <array name="theme_plasma_launcher_bfb_location_supported">
        <item>@integer/position_left</item>
    </array>
    <bool name="theme_plasma_launcher_bfb_visible_by_default">true</bool>
    <integer name="theme_plasma_launcher_preferences_location">@integer/position_none</integer>
    <drawable name="theme_plasma_launcher_preferences_image">@drawable/theme_plasma_res_launcher_preferences</drawable>
    <integer name="theme_plasma_launcher_preferences_location_when_panel_hidden">@integer/position_none</integer>
    <drawable name="theme_plasma_launcher_trash_image">@drawable/launcher_trash</drawable>
    <bool name="theme_plasma_launcher_applauncher_backgroundcolour_dynamic">false</bool>
    <color name="theme_plasma_launcher_applauncher_backgroundcolour">@android:color/transparent</color>
    <integer name="theme_plasma_launcher_applauncher_backgroundcolour_opacity">204</integer>
    <dimen name="theme_plasma_launcher_applauncher_margin">6dp</dimen>
    <dimen name="theme_plasma_launcher_applauncher_margin_edge">2dp</dimen>
    <drawable name="theme_plasma_launcher_applauncher_background">@drawable/blank_gradient</drawable>
    <drawable name="theme_plasma_launcher_applauncher_gradient">@android:color/transparent</drawable>
    <drawable name="theme_plasma_launcher_applauncher_running">@drawable/theme_plasma_res_launcher_app_running</drawable>
    <bool name="theme_plasma_launcher_applauncher_running_backgroundcolour_dynamic">false</bool>
    <color name="theme_plasma_launcher_applauncher_running_backgroundcolour">#EA2E6686</color>

    <!-- Panel -->
    <integer name="theme_plasma_panel_location">@integer/position_none</integer>
    <array name="theme_plasma_panel_location_supported">
        <item>@integer/position_none</item>
    </array>
    <dimen name="theme_plasma_panel_height">0dp</dimen>
    <drawable name="theme_plasma_panel_background">@android:color/transparent</drawable>
    <drawable name="theme_plasma_panel_background_when_dash_opened">@android:color/transparent</drawable>
    <drawable name="theme_plasma_statusbar_background">@android:color/transparent</drawable>
    <drawable name="theme_plasma_statusbar_background_when_panel_not_top">@android:color/transparent</drawable>
    <drawable name="theme_plasma_statusbar_colour_when_panel_hidden">@android:color/transparent</drawable>
    <bool name="theme_plasma_statusbar_follows_launcher_edge">false</bool>
    <drawable name="theme_plasma_statusbar_background_when_dash_opened">@android:color/transparent</drawable>
    <bool name="theme_plasma_panel_background_dynamic_when_dash_opened">false</bool>
    <integer name="theme_plasma_panel_bfb_location">@integer/position_none</integer>
    <drawable name="theme_plasma_panel_bfb_image">@android:color/transparent</drawable>
    <string name="theme_plasma_panel_bfb_text">@android:string/no</string>
    <color name="theme_plasma_panel_bfb_text_colour">@android:color/white</color>
    <integer name="theme_plasma_panel_close_location">@integer/position_none</integer>
    <drawable name="theme_plasma_panel_close_image">@android:color/transparent</drawable>
    <integer name="theme_plasma_panel_preferences_location">@integer/position_none</integer>
    <drawable name="theme_plasma_panel_preferences_image">@android:color/transparent</drawable>
    <array name="theme_plasma_panel_swap_close_preferences_when_launcher_location">
    </array>

    <!-- Dash -->
    <bool name="theme_plasma_dash_background_dynamic">false</bool>
    <drawable name="theme_plasma_dash_background">@drawable/theme_plasma_res_dash_background</drawable>
    <drawable name="theme_plasma_dash_background_gradient">@android:color/transparent</drawable>
    <color name="theme_plasma_dash_applauncher_text_colour">@android:color/white</color>
    <color name="theme_plasma_dash_applauncher_text_shadow_colour">@android:color/transparent</color>
    <color name="theme_plasma_dash_customise_text_colour">@android:color/white</color>
    <color name="theme_plasma_dash_customise_text_shadow_colour">@android:color/transparent</color>
    <dimen name="theme_plasma_dash_search_width">0dp</dimen>
    <drawable name="theme_plasma_dash_search_background">@drawable/theme_plasma_res_dash_search_background</drawable>
    <color name="theme_plasma_dash_search_text_colour">@android:color/white</color>
    <bool name="theme_plasma_dash_ribbon_show">false</bool>
    <dimen name="theme_plasma_dash_blur_radius">48dp</dimen>
    <integer name="theme_plasma_dash_animation">@integer/dash_animation_cinnamon</integer>
    <integer name="theme_plasma_profile_indicator">@integer/profile_indicator_none</integer>
</resources>
