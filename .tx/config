[main]
host = https://www.transifex.com

[o:distrohopper:p:distrohopper:r:stringsxml]
file_filter            = app/src/main/res/values-<lang>/translations.xml
source_file            = app/src/main/res/values-en_GB/translations.xml
source_lang            = en_GB
type                   = ANDROID
lang_map               = cs_CZ: cs, en_US: en-rUS, hi_IN: hi-rIN, zh_TW: zh-rTW
replace_edited_strings = false
keep_translations      = false

